# PANDA environment template
#
# Usage:
# 1. Copy this file to `.env`.
# 2. Change the values for your machine/environment.
# 3. Do not commit `.env`; it may contain credentials.

# Flask server port.
PORT=5001

# Root workspace.
# PANDA writes output files here and can read other project data from here.
# This can be the project root, or another folder that contains inputfiles/.
ROOT_DIRECTORY=.

# Local inventory folder.
# This folder must contain:
# - defaults.yaml
# - groups.yaml
# - hosts.yaml
#
# You can use an absolute path, or a path relative to where you run the app.
INVENTORY_DIRECTORY=inputfiles/inventory

# Optional NetBox source.
# Leave these empty if you only want to use the local inventory folder.
NETBOX_URL=
NETBOX_TOKEN=
