Value CURRENT_TIME (.+)
Value LAST_BOOT (.+)
Value TZ_INFO (.+)
Value TZ_DST_STATUS (.+)
Value TZ_DST_BEGIN (.+)
Value TZ_DST_END (.+)
Value SOURCE (\S+)

Start
  ^Current Time:\s+${CURRENT_TIME}
  ^Boot Time:\s+${LAST_BOOT}
  ^Timezone:\s+${TZ_INFO} -> TIMEZONE
  ^Source:\s+${SOURCE}

TIMEZONE
  ^\s+DST of ${TZ_DST_STATUS}
  ^\s+DST begins ${TZ_DST_BEGIN}
  ^\s+DST ends ${TZ_DST_END} -> Start