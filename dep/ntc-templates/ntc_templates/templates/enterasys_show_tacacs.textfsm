Value STATUS (Enabled|Disabled)
Value SESSION_ACCT (Enabled|Disabled)
Value COMMAND_AUTH (Enabled|Disabled)
Value COMMAND_ACCT (Enabled|Disabled)
Value SINGLE_CONNECT_STATE (Enabled|Disabled)
Value SERVICE (\S+)
Value READ_ONLY_PRIV (\d+)
Value READ_WRITE_PRIV (\d+)
Value SUPER_USER_PRIV (\d+)
Value PRI_IP (\S+)
Value PRI_PORT (\d+)
Value PRI_TIMEOUT (\d+)
Value SEC_IP (\S+)
Value SEC_PORT (\d+)
Value SEC_TIMEOUT (\d+)

Start
  ^TACACS\+ status:${STATUS}
  ^TACACS\+ session accounting state:${SESSION_ACCT}
  ^TACACS\+ command authorization state:${COMMAND_AUTH}
  ^TACACS\+ command accounting state:${COMMAND_ACCT}
  ^TACACS\+ single connect state:${SINGLE_CONNECT_STATE}
  ^TACACS\+ service: ${SERVICE}
  ^TACACS\+ session authorization A-V pairs:
  ^\s+access-level\s+attribute\s+value
  ^\s+read-only\s+priv-lvl\s+${READ_ONLY_PRIV}
  ^\s+read-write\s+priv-lvl\s+${READ_WRITE_PRIV}
  ^\s+super-user\s+priv-lvl\s+${SUPER_USER_PRIV}
  ^\s+TACACS\+ Server\s+IP address\s+Port\s+Timeout
  ^-+
  ^1\s+${PRI_IP}\s+${PRI_PORT}\s+${PRI_TIMEOUT}
  ^2\s+${SEC_IP}\s+${SEC_PORT}\s+${SEC_TIMEOUT}